{
  "name": "@f8team/reel-react",
  "version": "1.0.0",
  "description": "React adapter for @f8team/reel-core — composable slot API, hooks, and a one-liner <Player>.",
  "license": "MIT",
  "homepage": "https://github.com/f8team/player/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/f8team/player/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f8team/player.git",
    "directory": "packages/react"
  },
  "author": "F8 <devs@f8.edu.vn>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "size": "size-limit",
    "clean": "rm -rf dist coverage .turbo"
  },
  "keywords": [
    "video",
    "player",
    "react",
    "hooks",
    "headless",
    "f8",
    "media"
  ],
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "@f8team/reel-core": "^1.0.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^2.1.2",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.0",
    "@f8team/reel-core": "workspace:*"
  }
}
