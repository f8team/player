{
  "name": "@f8/player-lit",
  "version": "1.0.0",
  "description": "Lit adapter for @f8/player-core — <f8-player> custom element + ReactivePlayerController, parity with @f8/player-react.",
  "license": "MIT",
  "homepage": "https://github.com/f8/player/tree/main/packages/lit#readme",
  "bugs": {
    "url": "https://github.com/f8/player/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f8/player.git",
    "directory": "packages/lit"
  },
  "author": "F8 <devs@f8.edu.vn>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "size": "size-limit",
    "clean": "rm -rf dist coverage .turbo"
  },
  "keywords": [
    "video",
    "player",
    "lit",
    "web-components",
    "custom-element",
    "headless",
    "f8",
    "media"
  ],
  "peerDependencies": {
    "lit": ">=3",
    "@f8/player-core": ">=0.0.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "^25.0.1",
    "lit": "^3.1.0",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.0",
    "@f8/player-core": "workspace:*"
  }
}
