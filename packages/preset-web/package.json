{
  "name": "@f8team/reel-preset-web",
  "version": "1.0.0",
  "description": "Shared Default plugin bundles for Reel web apps (learner / admin / pro).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "f8",
    "player",
    "plugins",
    "preset"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "lint": "eslint src --max-warnings=0",
    "clean": "rm -rf dist coverage .turbo"
  },
  "peerDependencies": {
    "@f8team/reel-core": "^1.0.0",
    "@f8team/reel-plugin-auth-aware": "^1.0.0",
    "@f8team/reel-plugin-fullscreen": "^1.0.0",
    "@f8team/reel-plugin-hls-quality": "^1.0.0",
    "@f8team/reel-plugin-keyboard": "^1.0.0",
    "@f8team/reel-plugin-markers": "^1.0.0",
    "@f8team/reel-plugin-pip": "^1.0.0",
    "@f8team/reel-plugin-prefs": "^1.0.0",
    "@f8team/reel-plugin-subtitles": "^1.0.0",
    "@f8team/reel-plugin-thumbnails": "^1.0.0",
    "@f8team/reel-react": "^1.0.0",
    "@f8team/reel-lit": "^1.0.0",
    "react": ">=18.0.0",
    "lit": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@f8team/reel-react": {
      "optional": true
    },
    "@f8team/reel-lit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "lit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@f8team/reel-core": "workspace:*",
    "@f8team/reel-plugin-auth-aware": "workspace:*",
    "@f8team/reel-plugin-fullscreen": "workspace:*",
    "@f8team/reel-plugin-hls-quality": "workspace:*",
    "@f8team/reel-plugin-keyboard": "workspace:*",
    "@f8team/reel-plugin-markers": "workspace:*",
    "@f8team/reel-plugin-pip": "workspace:*",
    "@f8team/reel-plugin-prefs": "workspace:*",
    "@f8team/reel-plugin-subtitles": "workspace:*",
    "@f8team/reel-plugin-thumbnails": "workspace:*",
    "@f8team/reel-react": "workspace:*",
    "@f8team/reel-lit": "workspace:*",
    "@types/react": "^19.2.14",
    "react": "^19.2.6",
    "lit": "^3.2.0",
    "eslint": "^9.11.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.6",
    "@size-limit/preset-small-lib": "^11.0.0",
    "size-limit": "^11.0.0"
  }
}
