{
  "name": "reel",
  "version": "0.0.0",
  "private": true,
  "description": "Headless, framework-agnostic, plugin-driven video player engine. Powers F8 learning, story, and admin surfaces.",
  "license": "MIT",
  "homepage": "https://github.com/f8team/player#readme",
  "bugs": {
    "url": "https://github.com/f8team/player/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f8team/player.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "vitest run && turbo run test",
    "test:root": "vitest run",
    "test:watch": "turbo run test:watch --parallel",
    "test:coverage": "turbo run test:coverage",
    "lint": "eslint . && turbo run lint",
    "lint:fix": "eslint . --fix && turbo run lint -- --fix",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "size": "turbo run size",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:test": "test-storybook --url http://127.0.0.1:6006 --browsers chromium",
    "snapshot:update": "test-storybook --url http://127.0.0.1:6006 --browsers chromium -u",
    "docs:dev": "pnpm -C docs/site dev",
    "docs:build": "pnpm -C docs/site build",
    "lhci": "lhci autorun"
  },
  "pnpm": {
    "overrides": {
      "@vitest/coverage-v8": "^4.1.6",
      "vitest": "^4.1.6"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.11.1",
    "@lhci/cli": "^0.15.1",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test-runner": "^0.22.1",
    "@types/jest-image-snapshot": "^6.4.1",
    "@types/node": "^25.7.0",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^4.1.6",
    "axe-playwright": "^2.2.2",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "hls.js": "^1.6.16",
    "http-server": "^14.1.1",
    "jest-image-snapshot": "^6.5.2",
    "playwright": "^1.60.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.0",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.10"
  }
}
